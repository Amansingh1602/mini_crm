# Xeno CRM Backend — Environment Variables
# Copy this to .env and fill in your values

# ═══════════════════════════════════════════════════════════════
# Server Configuration
# ═══════════════════════════════════════════════════════════════
PORT=3001
NODE_ENV=production
BACKEND_URL="https://your-app.onrender.com"
FRONTEND_URL="https://your-app.vercel.app"

# ═══════════════════════════════════════════════════════════════
# Database (Neon PostgreSQL recommended for Render)
# ═══════════════════════════════════════════════════════════════
DATABASE_URL="postgresql://user:password@ep-xyz.us-east-1.postgres.vercel-storage.com/xeno_crm?schema=public"

# ═══════════════════════════════════════════════════════════════
# Redis (Upstash or RedisCloud recommended for Render)
# ═══════════════════════════════════════════════════════════════
REDIS_URL="redis://:password@xyz.upstash.io:12345"

# ═══════════════════════════════════════════════════════════════
# Groq AI Configuration
# ═══════════════════════════════════════════════════════════════
GROQ_API_KEY="gsk-your-key-here"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="llama-3.3-70b-versatile"

# ═══════════════════════════════════════════════════════════════
# Frontend URL (for CORS)
# ═══════════════════════════════════════════════════════════════
# For local development: http://localhost:3000
# For production: https://your-vercel-app.vercel.app

# ═══════════════════════════════════════════════════════════════
# Rate Limiting
# ═══════════════════════════════════════════════════════════════
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ═══════════════════════════════════════════════════════════════
# Authentication
# ═══════════════════════════════════════════════════════════════
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
GOOGLE_CLIENT_ID="your-google-client-id-here"
