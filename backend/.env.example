# Xeno CRM Backend — Environment Variables
# Copy this to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development

# Database (Neon PostgreSQL or local)
DATABASE_URL="postgresql://user:password@localhost:5432/xeno_crm?schema=public"

# Redis (Upstash or local)
REDIS_URL="redis://localhost:6379"

# OpenAI
OPENAI_API_KEY="sk-your-key-here"
OPENAI_MODEL="gpt-4o-mini"

# Channel Service URL
CHANNEL_SERVICE_URL="http://localhost:3002"

# CRM Callback URL (Channel Service calls this)
CRM_CALLBACK_URL="http://localhost:3001/api/receipts"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
