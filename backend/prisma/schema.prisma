// Prisma Schema — Autonomous Campaign Planner
// All 7 core models with proper relations, indexes, and enums

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────

enum CampaignStatus {
  DRAFT
  APPROVED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

enum Channel {
  WHATSAPP
  SMS
  EMAIL
  RCS
}

enum CommunicationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  OPENED
  READ
  CLICKED
  PURCHASED
}

enum EventType {
  SENT
  DELIVERED
  FAILED
  OPENED
  READ
  CLICKED
  PURCHASED
}

// ─── Customer ─────────────────────────────────────────────

model Customer {
  id               String          @id @default(cuid())
  name             String
  email            String          @unique
  phone            String?
  city             String?
  age              Int?
  gender           String?
  totalSpent       Float           @default(0)
  lastPurchaseDate DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  orders           Order[]
  communications   Communication[]

  @@index([city])
  @@index([totalSpent])
  @@index([lastPurchaseDate])
  @@index([createdAt])
}

// ─── Order ────────────────────────────────────────────────

model Order {
  id         String   @id @default(cuid())
  customerId String
  amount     Float
  category   String
  createdAt  DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([category])
  @@index([createdAt])
  @@index([amount])
}

// ─── Audience ─────────────────────────────────────────────

model Audience {
  id            String     @id @default(cuid())
  name          String
  description   String?
  filters       Json       // Structured filter criteria from AI
  filterSQL     String?    // Generated WHERE clause for debugging
  reasoning     String     // AI explanation of audience logic
  customerCount Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  campaigns     Campaign[]

  @@index([createdAt])
}

// ─── Campaign ─────────────────────────────────────────────

model Campaign {
  id               String         @id @default(cuid())
  audienceId       String
  title            String
  goal             String         // Original user goal/prompt
  offer            String?
  message          String         // Generated message content
  cta              String?        // Call to action
  channel          Channel
  status           CampaignStatus @default(DRAFT)
  
  // AI-generated predictions
  predictedMetrics Json?          // { deliveryRate, openRate, ctr, conversionRate }
  
  // AI reasoning
  audienceReasoning  String?      // Why this audience
  messageReasoning   String?      // Why this message
  channelReasoning   String?      // Why this channel
  offerReasoning     String?      // Why this offer

  scheduledAt      DateTime?
  launchedAt       DateTime?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  audience         Audience       @relation(fields: [audienceId], references: [id])
  communications   Communication[]
  analytics        CampaignAnalytics?
  insights         CampaignInsight[]

  @@index([status])
  @@index([audienceId])
  @@index([createdAt])
  @@index([channel])
}

// ─── Communication ────────────────────────────────────────

model Communication {
  id           String              @id @default(cuid())
  campaignId   String
  customerId   String
  channel      Channel
  message      String
  status       CommunicationStatus @default(PENDING)
  sentAt       DateTime?
  deliveredAt  DateTime?
  failedAt     DateTime?
  openedAt     DateTime?
  readAt       DateTime?
  clickedAt    DateTime?
  purchasedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  campaign     Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  events       CommunicationEvent[]

  @@index([campaignId])
  @@index([customerId])
  @@index([status])
  @@index([campaignId, status])
}

// ─── Communication Event ──────────────────────────────────
// Immutable event log — append-only for auditability

model CommunicationEvent {
  id              String   @id @default(cuid())
  communicationId String
  type            EventType
  timestamp       DateTime @default(now())
  metadata        Json?    // Channel-specific metadata
  idempotencyKey  String   @unique // Prevents duplicate event processing

  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId])
  @@index([type])
  @@index([timestamp])
}

// ─── Campaign Analytics ───────────────────────────────────
// Denormalized counters for fast dashboard reads

model CampaignAnalytics {
  id          String   @id @default(cuid())
  campaignId  String   @unique
  
  total       Int      @default(0)
  sent        Int      @default(0)
  delivered   Int      @default(0)
  failed      Int      @default(0)
  opened      Int      @default(0)
  read        Int      @default(0)
  clicked     Int      @default(0)
  purchased   Int      @default(0)
  revenue     Float    @default(0)

  updatedAt   DateTime @updatedAt

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

// ─── Campaign Insights ────────────────────────────────────
// AI-generated post-campaign analysis

model CampaignInsight {
  id           String   @id @default(cuid())
  campaignId   String
  insight      String   // AI-generated insight text
  category     String   // e.g., "audience", "message", "channel", "offer"
  severity     String   // "info", "warning", "critical"
  recommendation String // Actionable next step
  createdAt    DateTime @default(now())

  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}
