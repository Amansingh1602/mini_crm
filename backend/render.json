{
  "name": "xeno-crm-backend",
  "description": "AI-Native Mini CRM Backend — Autonomous Campaign Planner",
  "buildCommand": "npm install && npm run build",
  "startCommand": "npm start",
  "plan": "free",
  "envVars": [
    {
      "key": "NODE_ENV",
      "value": "production"
    },
    {
      "key": "PORT",
      "value": "3001"
    },
    {
      "key": "DATABASE_URL",
      "fromDatabase": {
        "name": "xeno-crm-db"
      }
    },
    {
      "key": "REDIS_URL"
    },
    {
      "key": "GROQ_API_KEY"
    },
    {
      "key": "JWT_SECRET"
    },
    {
      "key": "FRONTEND_URL"
    },
    {
      "key": "BACKEND_URL"
    }
  ]
}
